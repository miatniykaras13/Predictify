{
  "name": "predictify",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint --no-config-lookup --config eslint.config.mjs . --max-warnings 0",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern \"frontend/**/*\" \"backend/**/*\" \"*.mjs\" \".prettierrc.json\" \"package.json\" \".github/workflows/*.{yml,yaml}\"",
    "format": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern \"frontend/**/*\" \"backend/**/*\" \"*.mjs\" \".prettierrc.json\" \"package.json\" \".github/workflows/*.{yml,yaml}\"",
    "commitlint": "node lint-commits.mjs"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
