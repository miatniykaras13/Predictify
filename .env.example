# Set both passwords before starting Compose. Use a URL-safe PostgreSQL password.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=predictify
MINIO_ROOT_PASSWORD=

# Authentication. Generate a key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_ACCESS_TOKEN_SECRET=
# Set explicitly when the browser uses a different origin from the default loopback address.
AUTH_APP_ORIGIN=

# Ports on 127.0.0.1
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
