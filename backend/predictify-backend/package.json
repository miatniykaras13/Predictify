{
  "name": "predictify-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Predictify backend API scaffold",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "test": "vitest run --dir test --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --dir test --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --dir test integration.test.ts",
    "migrate:up": "node-pg-migrate up -m migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m migrations --database-url-var DATABASE_URL",
    "migrate:create": "node-pg-migrate create -m migrations",
    "db:reset": "npm run migrate:down -- --count 999 && npm run migrate:up"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.9",
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.1",
    "node-pg-migrate": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
